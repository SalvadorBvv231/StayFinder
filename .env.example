# Base de datos PostgreSQL (Neon)
# DATABASE_URL: conexión con pooling (host con "-pooler"), usada por la app en runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# DIRECT_URL: conexión directa (sin "-pooler"), usada por el CLI de Prisma (migrate, db seed).
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
